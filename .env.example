# Server Port
PORT=3000

# Your custom domain(s) from DigitalPlat or Cloudflare (comma-separated if multiple)
# Example: mydomain.com or temp.mydomain.com
DOMAINS=yourdomain.com,temp.yourdomain.com

# Secret key to protect incoming email webhook from unauthorized spam/abuse
# (Must match the secret set in Cloudflare Worker)
WEBHOOK_SECRET=your-super-secret-webhook-key-here-12345

# Email Time-To-Live in minutes (emails and inactive inboxes will be deleted after this)
# 60 = 1 hour, 1440 = 24 hours
EMAIL_TTL_MINUTES=60

# Maximum emails stored per mailbox
MAX_EMAILS_PER_MAILBOX=100
